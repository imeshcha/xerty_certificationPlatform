# ==============================================================================
# XERTY BACKEND ENVIRONMENT CONFIGURATION ($0 FREE TIER)
# ==============================================================================

# Server
PORT=4000
NODE_ENV=production
CORS_ORIGIN=https://xerty.vercel.app

# Database - MongoDB Atlas (M0 Free Tier)
# Get free URI from: https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/xerty?retryWrites=true&w=majority

# Decentralized Storage - Pinata IPFS (Free Tier)
# Get free API keys from: https://app.pinata.cloud/developers/api-keys
PINATA_API_KEY=your_pinata_api_key
PINATA_API_SECRET=your_pinata_api_secret
PINATA_JWT=your_pinata_jwt_token
PINATA_GATEWAY_URL=https://gateway.pinata.cloud/ipfs

# Authentication - Privy (Free Tier - 1,000 MAUs)
# Get free credentials from: https://dashboard.privy.io
PRIVY_APP_ID=your_privy_app_id
PRIVY_APP_SECRET=your_privy_app_secret

# Blockchain - Arbitrum Sepolia Testnet (Chain ID: 421614)
# Free RPC: https://sepolia-rollup.arbitrum.io/rpc or Alchemy Free Tier
BLOCKCHAIN_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
BLOCKCHAIN_CHAIN_ID=421614
BLOCKCHAIN_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
BLOCKCHAIN_PRIVATE_KEY=your_deployer_or_relayer_private_key
